# Postgres connection string (Neon / Vercel Postgres / Supabase ...). Required.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Long random string used to sign login tokens. Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Optional: password for the default "admin" account, used only when it is first created (default: 123).
# ADMIN_PASSWORD=123
